# Copy to .env for local use. On Vercel, add the same names under Project → Settings → Environment Variables.

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# the "service_role" secret key (NOT the anon key). Keep it private — never put it in website files.
SUPABASE_SERVICE_ROLE_KEY=

# First admin password (used only the first time, before you change it in the admin panel). Required on Vercel.
ADMIN_PASSWORD=

# Optional: your live address, used in sitemap.xml and robots.txt (default: the website in Company details)
SITE_URL=https://www.skyrahimpex.com
